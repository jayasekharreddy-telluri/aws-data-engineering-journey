-- BLOCK 4 — ICEBERG SETUP
-- ───────────────────────────────────────────────────────────────────────────────

-- 4A. Create the Iceberg database
-- Run this ONCE before any other Iceberg queries
CREATE DATABASE IF NOT EXISTS swiggy_iceberg_db;


-- 4B. Create Iceberg table from existing gold data (CTAS)
-- Replace <your-bucket> with your actual S3 bucket name
-- This is the main conversion — run it and walk through the output
CREATE TABLE swiggy_iceberg_db.daily_city_revenue
WITH (
    table_type         = 'ICEBERG',
    location           = 's3://<your-bucket>/iceberg/daily_city_revenue/',
    is_external        = false,
    format             = 'PARQUET',
    write_compression  = 'SNAPPY',
    partitioning       = ARRAY['city']
)
AS
SELECT
    order_date,
    city,
    total_orders,
    total_revenue,
    avg_order_value,
    largest_order
FROM swiggy_gold_db.daily_city_revenue;
-- Expected: ~600 rows created
-- Data scanned: reads from gold Parquet, writes to Iceberg format


-- 4C. Verify the Iceberg table
SELECT COUNT(*) AS row_count
FROM   swiggy_iceberg_db.daily_city_revenue;

SELECT order_date, city, total_orders, total_revenue
FROM   swiggy_iceberg_db.daily_city_revenue
WHERE  city = 'Bangalore'
ORDER BY order_date DESC
LIMIT 5;


-- 4D. Check Iceberg table metadata (what makes it Iceberg)
-- This reads the manifest files — Iceberg's metadata layer
SELECT *
FROM "swiggy_iceberg_db"."daily_city_revenue$files"
LIMIT 10;
-- Shows the Parquet files tracked by Iceberg's metadata layer


-- ───────────────────────────────────────────────────────────────────────────────
-- BLOCK 5 — ICEBERG FEATURES
-- ───────────────────────────────────────────────────────────────────────────────

-- ── TIME TRAVEL ────────────────────────────────────────────────────────────────

-- 5A. Check current snapshot (before any changes)
SELECT * FROM "swiggy_iceberg_db"."daily_city_revenue$snapshots"
ORDER BY committed_at DESC;
-- Shows snapshot_id and committed_at timestamp
-- Note the snapshot_id — you'll use it for time travel


-- 5B. Simulate a data update — INSERT some new rows
INSERT INTO swiggy_iceberg_db.daily_city_revenue
VALUES
    (DATE '2024-12-11', 'Bangalore', 312, 187450.00, 601.44, 4200.00),
    (DATE '2024-12-11', 'Mumbai',    287, 171200.00, 596.51, 3950.00),
    (DATE '2024-12-11', 'Hyderabad', 198, 118500.00, 598.48, 3100.00);
-- 3 new rows representing Dec 11 data that just arrived


-- 5C. Verify the INSERT landed
SELECT COUNT(*) FROM swiggy_iceberg_db.daily_city_revenue;
-- Should be original count + 3


-- 5D. Check snapshots again — new snapshot appeared
SELECT * FROM "swiggy_iceberg_db"."daily_city_revenue$snapshots"
ORDER BY committed_at DESC;
-- Now shows 2 snapshots — original CTAS + this INSERT
-- Note the snapshot_id of the ORIGINAL (first) snapshot


-- 5E. TIME TRAVEL — query data AS OF the original snapshot
-- Replace <original_snapshot_id> with the ID from step 5D
SELECT COUNT(*) AS row_count_before_insert
FROM swiggy_iceberg_db.daily_city_revenue
FOR VERSION AS OF <original_snapshot_id>;
-- Returns original count — the INSERT is invisible
-- This is time travel. The table "remembers" its past states.


-- 5F. TIME TRAVEL — query AS OF a specific timestamp
-- Replace the timestamp with something between CTAS and INSERT
SELECT COUNT(*) AS row_count_at_time
FROM swiggy_iceberg_db.daily_city_revenue
FOR TIMESTAMP AS OF TIMESTAMP '2024-12-11 00:00:00 UTC';
-- Returns pre-INSERT count if timestamp is before the INSERT committed


-- 5G. Simulate a DELETE — remove one city's data to show recovery
DELETE FROM swiggy_iceberg_db.daily_city_revenue
WHERE city = 'Hyderabad' AND order_date = DATE '2024-12-11';

-- Verify it's gone
SELECT * FROM swiggy_iceberg_db.daily_city_revenue
WHERE city = 'Hyderabad' AND order_date = DATE '2024-12-11';
-- Returns 0 rows

-- Recover it via time travel — go back to snapshot before DELETE
-- Replace <pre_delete_snapshot_id> with snapshot ID before the DELETE
INSERT INTO swiggy_iceberg_db.daily_city_revenue
SELECT *
FROM swiggy_iceberg_db.daily_city_revenue
FOR VERSION AS OF <pre_delete_snapshot_id>
WHERE city = 'Hyderabad' AND order_date = DATE '2024-12-11';

-- Verify recovery
SELECT * FROM swiggy_iceberg_db.daily_city_revenue
WHERE city = 'Hyderabad' AND order_date = DATE '2024-12-11';
-- Row is back


-- ── SCHEMA EVOLUTION ───────────────────────────────────────────────────────────

-- 5H. Add a new column to the Iceberg table (LIVE, no rewrite)
ALTER TABLE swiggy_iceberg_db.daily_city_revenue
ADD COLUMNS (day_of_week VARCHAR);
-- Instant — no data rewrite. Iceberg tracks schema versions in metadata.
-- Existing rows have NULL for the new column.


-- 5I. Verify the new column exists
SELECT order_date, city, total_revenue, day_of_week
FROM   swiggy_iceberg_db.daily_city_revenue
WHERE  city = 'Bangalore'
LIMIT 5;
-- day_of_week shows NULL for existing rows — expected


-- 5J. Populate the new column for new inserts going forward
INSERT INTO swiggy_iceberg_db.daily_city_revenue
VALUES (DATE '2024-12-12', 'Bangalore', 298, 178800.00, 599.66, 3800.00, 'Thursday');
-- New row has day_of_week populated; old rows still have NULL
-- Both coexist in the same table — this is schema evolution


-- 5K. Rename a column (Iceberg supports this — Parquet tables don't)
ALTER TABLE swiggy_iceberg_db.daily_city_revenue
RENAME COLUMN largest_order TO max_order_value;
-- Instant rename. No data moved. Metadata updated.
-- Try this on a regular Parquet table in swiggy_gold_db — it fails.


