-- B1. Show top 5 revenue days across all cities
SELECT order_date, SUM(total_revenue) AS daily_total
FROM   swiggy_gold_db.daily_city_revenue
GROUP BY order_date
ORDER BY daily_total DESC
LIMIT 5;


-- B2. City with most VIP customers
SELECT city, COUNT(*) AS vip_count
FROM   swiggy_gold_db.customer_segments
WHERE  segment = 'VIP'
GROUP BY city
ORDER BY vip_count DESC
LIMIT 3;


-- B3. Average order value trend — week over week
SELECT
    DATE_TRUNC('week', order_date) AS week_start,
    city,
    ROUND(AVG(avg_order_value), 2) AS weekly_avg
FROM swiggy_gold_db.daily_city_revenue
GROUP BY DATE_TRUNC('week', order_date), city
ORDER BY city, week_start;


-- B4. Cross-source: negative feedback from high-value customers
SELECT
    cs.customer_id,
    cs.customer_name,
    cs.segment,
    cs.total_spent,
    cf.rating,
    cf.feedback_text
FROM swiggy_gold_db.customer_segments cs
JOIN swiggy_silver_db.customer_feedback cf
    ON cs.customer_id = cf.customer_id
WHERE cs.segment = 'VIP'
AND   cf.sentiment = 'negative'
ORDER BY cs.total_spent DESC;
-- Business value: identify VIP customers at churn risk


-- B5. Iceberg time travel for audit — who changed what and when
SELECT snapshot_id, committed_at, operation, summary
FROM   "swiggy_iceberg_db"."daily_city_revenue$snapshots"
ORDER BY committed_at;
-- Full audit trail of every change to the Iceberg table
-- This is what compliance teams love about Iceberg
