-- ───────────────────────────────────────────────────────────────────────────────
-- BLOCK 3 — ATHENA OPTIMIZATION
-- ───────────────────────────────────────────────────────────────────────────────

-- 3A. Partition pruning demo — WITH partition filter (fast, cheap)
SELECT order_date, total_orders, total_revenue
FROM   swiggy_gold_db.daily_city_revenue
WHERE  city = 'Bangalore'          -- ← partition filter
ORDER BY order_date DESC
LIMIT 10;
-- Note the "Data scanned" — only Bangalore partition read


-- 3B. Without partition filter (slower, more expensive)
SELECT order_date, city, total_orders, total_revenue
FROM   swiggy_gold_db.daily_city_revenue
ORDER BY total_revenue DESC
LIMIT 10;
-- Note the "Data scanned" — ALL city partitions read
-- Compare to 3A — same result set available, but 3A costs less


-- 3C. Columnar advantage demo — select fewer columns
-- This scans LESS data because Parquet is columnar
SELECT order_date, total_revenue
FROM   swiggy_gold_db.daily_city_revenue
WHERE  city = 'Mumbai';
-- vs
SELECT *
FROM   swiggy_gold_db.daily_city_revenue
WHERE  city = 'Mumbai';
-- Run both, compare "Data scanned" — SELECT * costs more


-- 3D. Result reuse demo
-- Run this query twice in quick succession (within 24 hours)
SELECT cuisine, SUM(total_revenue) AS rev
FROM   swiggy_gold_db.cuisine_performance
GROUP BY cuisine
ORDER BY rev DESC;
-- Second run: check "Data scanned" = 0 bytes — served from cache
-- Athena reuses results for identical queries on unchanged data


-- 3E. Approximate aggregations (faster on large datasets)
SELECT approx_distinct(customer_id) AS approx_unique_customers
FROM   swiggy_silver_db.orders;
-- approx_distinct is ~2% error but much faster than COUNT(DISTINCT)
-- Use for dashboards where exactness isn't critical


-- 3F. Cross-source query combining silver + gold
SELECT
    g.city,
    g.cuisine,
    g.revenue_share_pct,
    COUNT(o.order_id) AS silver_order_count
FROM swiggy_gold_db.cuisine_performance g
JOIN swiggy_silver_db.orders o
    ON g.city = o.city
WHERE g.cuisine_rank_in_city <= 3
GROUP BY g.city, g.cuisine, g.revenue_share_pct
ORDER BY g.city, g.revenue_share_pct DESC;


